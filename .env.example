# ============================================================
# OKX API — ключи создаются на www.okx.com -> API Management
# Права ключа: Read + Trade (Withdraw НЕ включать никогда)
# ============================================================
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# true = торговать на демо-счёте OKX (Simulated Trading, заголовок x-simulated-trading: 1)
OKX_SIMULATED=true

# ============================================================
# TELEGRAM — бот и chat id для уведомлений/команд
# Получить токен у @BotFather, chat id — у @userinfobot
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# РЕЖИМЫ РАБОТЫ
# ============================================================
# Главный рубильник реальной торговли. Пока false — бот только
# сканирует рынок, считает сигналы и шлёт их в Telegram (paper/signals-only).
AUTO_TRADE=false
# Доп. защита: даже если AUTO_TRADE=true, при DRY_RUN=true ордера
# не отправляются на биржу, только логируются как "would place order".
DRY_RUN=true

# ============================================================
# СКРИНИНГ / ВСЕЛЕННАЯ
# ============================================================
# Через запятую можно принудительно исключить инструменты
SYMBOL_BLACKLIST=
# Минимальный 24ч оборот в USDT для рассмотрения пары
MIN_24H_QUOTE_VOLUME_USDT=3000000
# Минимальный открытый интерес в USD
MIN_OI_USD=500000
# Диапазон 24ч изменения цены, %
MIN_24H_CHANGE_PCT=3
MAX_24H_CHANGE_PCT=18
# Порог экстремального funding rate за период (доля, 0.0005 = 0.05%)
MAX_ABS_FUNDING_RATE=0.0005
# Минимальное доступное плечо инструмента
MIN_MAX_LEVER=10
# Максимальный спред (ask-bid)/mid
MAX_SPREAD_PCT=0.0015
# Порог входа по score (0..10)
MIN_ENTRY_SCORE=7.5

# ============================================================
# LONG/SHORT CROWDING FILTER
# ============================================================
LS_RATIO_PERIOD=5m
LS_CROWDING_LONG_PCT=78
LS_CROWDING_DELTA_PP=8
# включить экспериментальный режим SHORT при экстремальном crowding + rejection
ENABLE_CROWDING_SHORT_FADE=false

# ============================================================
# РИСК / РАЗМЕР ПОЗИЦИИ
# ============================================================
RISK_USD_PER_TRADE=5
MAX_PORTFOLIO_RISK_PCT=15
MAX_OPEN_POSITIONS=1
DEFAULT_LEVERAGE=8
MAX_LEVERAGE=20
HIGH_LEVERAGE_MIN_SCORE=8.5
MGN_MODE=isolated

# Управление сделкой
TP1_PCT=2.0
TP1_CLOSE_RATIO=0.6
SL_PCT=2.0
TRAIL_PCT=1.0
MAX_ENTRY_CHASE_PCT=0.4
TRADE_TIMEOUT_MIN=25

# ============================================================
# ЗАЩИТЫ
# ============================================================
DAILY_LOSS_LIMIT_USD=20
DAILY_LOSS_LIMIT_PCT=10
MAX_TRADES_PER_DAY=10
COOLDOWN_AFTER_LOSSES=2
COOLDOWN_MINUTES=45
API_ERROR_STREAK_HALT=5

# ============================================================
# ЦИКЛ
# ============================================================
SCAN_INTERVAL_SEC=90
MANAGE_INTERVAL_SEC=15
